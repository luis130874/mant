# Optional Firebase App Check (reCAPTCHA Enterprise Site Key for Web)
# Configure also in firebase-applet-config.json -> recaptchaSiteKey when enforcing App Check
VITE_RECAPTCHA_SITE_KEY=

# Optional initial Super Admin email for first-time greenfield bootstrap
# (Prefer Firebase Auth Custom Claim `role: "super_admin"` in production)
VITE_INITIAL_SUPER_ADMIN_EMAIL=
